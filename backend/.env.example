# RecruitO backend environment configuration
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed.

# --- Database ---
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruito

# --- Email / OTP (Gmail SMTP) ---
# For Gmail, generate an App Password (https://myaccount.google.com/apppasswords)
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# --- Admin seed account (used by app/seed_admin.py) ---
ADMIN_EMAIL=admin@recruito.com
ADMIN_PASSWORD=change-me-strong-password

# --- Security ---
# JWT signing secret. Use a long, random string in production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret
# JWT access token lifetime in minutes (default 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60
